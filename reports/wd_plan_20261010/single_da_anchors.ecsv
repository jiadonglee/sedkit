# %ECSV 1.0
# ---
# datatype:
# - {name: catalogue, datatype: string}
# - {name: name, datatype: string}
# - name: source_id
#   datatype: int64
#   description: Unique source identifier (unique within a particular Data Release)
#   meta: !!omap
#   - {ucd: meta.id}
# - {name: spectral_type, datatype: string}
# - {name: teff, datatype: float64}
# - {name: logg, datatype: float64}
# - {name: label_method, datatype: string}
# - {name: known_binary, datatype: bool}
# - {name: corrected_3d, datatype: bool}
# - name: ra
#   unit: deg
#   datatype: float64
#   description: Right ascension
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {utype: 'stc:AstroCoords.Position3D.Value3.C1'}
# - name: dec
#   unit: deg
#   datatype: float64
#   description: Declination
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {utype: 'stc:AstroCoords.Position3D.Value3.C2'}
# - name: parallax
#   unit: mas
#   datatype: float64
#   description: Parallax
#   meta: !!omap
#   - {ucd: pos.parallax.trig}
# - name: parallax_error
#   unit: mas
#   datatype: float32
#   description: Standard error of parallax
#   meta: !!omap
#   - {ucd: stat.error;pos.parallax.trig}
# - name: phot_g_mean_mag
#   unit: mag
#   datatype: float32
#   description: G-band mean magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt}
# - name: bp_rp
#   unit: mag
#   datatype: float32
#   description: BP - RP colour
#   meta: !!omap
#   - {ucd: phot.color;em.opt.B;em.opt.R}
# - name: ruwe
#   datatype: float32
#   description: Renormalised unit weight error
#   meta: !!omap
#   - {ucd: stat.error}
# - name: has_xp_continuous
#   datatype: bool
#   description: Flag indicating the availability of mean BP/RP spectrum in continuous representation for this source
#   meta: !!omap
#   - {ucd: meta.code.status}
# - name: has_xp_sampled
#   datatype: bool
#   description: Flag indicating the availability of mean BP/RP spectrum in sampled form for this source
#   meta: !!omap
#   - {ucd: meta.code.status}
# - {name: da_candidate, datatype: bool}
# - {name: da_label_ready, datatype: bool}
# - {name: fold, datatype: int64}
# schema: astropy-2.0
catalogue name source_id spectral_type teff logg label_method known_binary corrected_3d ra dec parallax parallax_error phot_g_mean_mag bp_rp ruwe has_xp_continuous has_xp_sampled da_candidate da_label_ready fold
